import { Request, Response, NextFunction } from 'express'
import { UsersService, SafeLoggingService } from '@services'

export function isAuthorizedUser(user: string) {
  const status = UsersService.getUserStatus(user)
  if (status !== 'blocked' || status !== 'deleted') {
    return true
  }
  return false
}

export function searchProducts2 () {
  return (req: Request, res: Response, next: NextFunction) => {
    let criteria: any = req.query.q === 'undefined' ? '' : req.query.q ?? ''
    criteria = (criteria.length <= 200) ? criteria : criteria.substring(0, 200)
    //authenticated user (handled via middleware)
    const user = req.user
    if (!isAuthorizedUser(user)) {
      res.status(403).send()
      return
    }
    
    models.sequelize.query(`SELECT name, description FROM Products3 WHERE ((name LIKE '%${criteria}%' OR description LIKE '%${criteria}%') AND deletedAt IS NULL) ORDER BY name`)
        .then(([products]: any) => {
          const dataString = JSON.stringify(products)
          for (let i = 0; i < products.length; i++) {
            products[i].name = req.__(products[i].name)
            products[i].description = req.__(products[i].description)
          }
          res.json(utils.queryResultToJson(products))
        }).catch((error: ErrorWithParent) => {
      next(SafeLoggingService.sanitizeError(error.parent))
    })
  }
}

